{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/osintph/routemap/blob/main/routemap_engine/route.schema.json",
  "title": "Route",
  "description": "One analysed traceroute: Route.to_dict(). Also the body of FalconEye's POST /api/routemap/analyze.",
  "type": "object",
  "required": [
    "parser",
    "parser_label",
    "target",
    "warnings",
    "hoiho_ruleset_date",
    "origin",
    "hops"
  ],
  "additionalProperties": false,
  "properties": {
    "parser": {
      "enum": [
        "tracert",
        "traceroute",
        "mtr",
        "hops",
        "icmp"
      ]
    },
    "parser_label": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "description": "What the trace banner said was traced, if anything."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hoiho_ruleset_date": {
      "type": [
        "string",
        "null"
      ],
      "description": "CAIDA Hoiho ruleset date, when Hoiho answered from the network."
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "hops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hop"
      }
    },
    "paths": {
      "description": "Path discovery (0.7.0, routemap_engine.multipath): present only for a route made by analyse_paths. Paths found over ICMP are a lower bound (at_least).",
      "$ref": "#/$defs/paths"
    }
  },
  "$defs": {
    "coord_lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "coord_lon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "origin": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "label",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "$ref": "#/$defs/coord_lat"
        },
        "lon": {
          "$ref": "#/$defs/coord_lon"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "supplied",
            "first-hop",
            "none"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "source",
        "accepted"
      ],
      "properties": {
        "source": {
          "enum": [
            "hoiho",
            "site-code",
            "ip-db"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "place": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "$ref": "#/$defs/coord_lat"
        },
        "lon": {
          "$ref": "#/$defs/coord_lon"
        },
        "distance_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "rtt_budget_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "why": {
          "type": "string"
        },
        "match_strs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "match_meanings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carrier": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "ripestat",
            "dbip"
          ],
          "description": "Which IP database tier answered: RIPEstat (online) or DB-IP Lite City (offline)."
        }
      },
      "additionalProperties": false
    },
    "hop": {
      "type": "object",
      "required": [
        "hop",
        "addresses",
        "address",
        "hostnames",
        "hostname",
        "min_rtt_ms",
        "avg_rtt_ms",
        "sent",
        "lost",
        "loss_pct",
        "codes",
        "source",
        "lat",
        "lon",
        "place",
        "cc",
        "distance_km",
        "rtt_budget_km",
        "annotations",
        "reason",
        "candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "hop": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "description": "The address that produced the placement, else the first."
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ],
          "description": "The hostname that produced the placement, else the first."
        },
        "min_rtt_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_rtt_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "sent": {
          "type": "integer",
          "minimum": 0
        },
        "lost": {
          "type": "integer",
          "minimum": 0
        },
        "loss_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "enum": [
            "hoiho",
            "site-code",
            "ip-db",
            "local",
            "unresolved"
          ]
        },
        "lat": {
          "$ref": "#/$defs/coord_lat"
        },
        "lon": {
          "$ref": "#/$defs/coord_lon"
        },
        "place": {
          "type": [
            "string",
            "null"
          ]
        },
        "cc": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "rtt_budget_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "annotations": {
          "type": "array",
          "items": {
            "enum": [
              "local / ISP internal",
              "location impossible for RTT",
              "likely asymmetric return path",
              "ICMP rate limiting, not real loss",
              "destination or path does not answer ICMP"
            ]
          }
        },
        "annotation_details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the hop is unplaced, or how a local hop was handled."
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "match_strs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "match_meanings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carrier": {
          "type": "string"
        },
        "site_code": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "country"
          ],
          "description": "Present only when the hop is placed to country level: the coordinates are a country centroid, not a city."
        },
        "ip_provider": {
          "enum": [
            "ripestat",
            "dbip"
          ],
          "description": "Which IP database tier answered: RIPEstat (online) or DB-IP Lite City (offline)."
        },
        "asn": {
          "type": "integer",
          "minimum": 1,
          "description": "Autonomous system number of the hop's address."
        },
        "as_org": {
          "type": "string",
          "description": "The AS's organisation name."
        },
        "as_network": {
          "type": "string",
          "description": "The database range containing the address (not necessarily the routed prefix)."
        },
        "asn_source": {
          "enum": [
            "dbip",
            "ripestat"
          ],
          "description": "Where the ASN came from."
        },
        "ixp": {
          "type": "string",
          "description": "Internet exchange the hop's address belongs to."
        }
      }
    },
    "path_hop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hop",
        "address",
        "lat",
        "lon",
        "source"
      ],
      "properties": {
        "hop": {
          "type": "integer",
          "minimum": 1
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "anyOf": [
            {
              "$ref": "#/$defs/coord_lat"
            },
            {
              "type": "null"
            }
          ]
        },
        "lon": {
          "anyOf": [
            {
              "$ref": "#/$defs/coord_lon"
            },
            {
              "type": "null"
            }
          ]
        },
        "place": {
          "type": [
            "string",
            "null"
          ]
        },
        "cc": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "min_rtt_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_rtt_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "flows",
        "hops",
        "rtt_ms",
        "reached",
        "sent",
        "lost",
        "loss_pct",
        "rtt_to_target_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-P]$"
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "maxItems": 64
        },
        "hops": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxItems": 30
        },
        "rtt_ms": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "maxItems": 30
        },
        "reached": {
          "type": "boolean"
        },
        "sent": {
          "type": "integer",
          "minimum": 0
        },
        "lost": {
          "type": "integer",
          "minimum": 0
        },
        "loss_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "rtt_to_target_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "located": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path_hop"
          },
          "maxItems": 30
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "at_least",
        "af",
        "paths",
        "per_packet_hops",
        "probes_sent",
        "flows",
        "paths_capped",
        "stopped_by",
        "seconds"
      ],
      "properties": {
        "method": {
          "const": "icmp-paris"
        },
        "at_least": {
          "const": true
        },
        "af": {
          "enum": [
            4,
            6
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 16
        },
        "per_packet_hops": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "probes_sent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1500
        },
        "flows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "paths_capped": {
          "type": "boolean"
        },
        "stopped_by": {
          "enum": [
            "complete",
            "budget",
            "cancel",
            "deadline",
            "gap",
            "max_hops"
          ]
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
